# ============================================
# LLM Benchmark - Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# The web app (npm run dev) only needs the OTEL_* vars.
# The benchmark (npm run benchmark) needs the OpenRouter + Tinybird vars.

# --- OpenRouter (required for benchmark) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx

# --- Tinybird (required for benchmark) ---
TINYBIRD_API_HOST=https://api.europe-west2.gcp.tinybird.co
TINYBIRD_WORKSPACE_TOKEN=p.xxxxxxxxxx

# --- GitHub Actions (set as repo variables in Settings > Variables > Actions) ---
PR_ASSIGNEES=comma,separated,usernames
REVIEW_MODEL=openai/gpt-5.4-nano
AUTO_MERGE=true

# --- Debug (optional) ---
LLM_DEBUG=0

# --- OpenTelemetry (optional, used by the web app) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://tinybird-otel-collector.fly.dev:4318
OTEL_SERVICE_NAME=llm-benchmark
OTEL_LOG_LEVEL=debug
